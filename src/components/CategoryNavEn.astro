---
// 核心分类导航 - 英文版纯文字分栏设计
const categories = [
  { id: "all", name: "All" },
  { id: "人工智能", name: "AI" },
  { id: "具身智能", name: "Embodied AI" },
  { id: "财经", name: "Finance" },
  { id: "天津", name: "Tianjin" },
  { id: "创投", name: "Venture" },
];

// 分类映射：核心分类 → RSS 原始分类
const categoryMapping: Record<string, string[]> = {
  "人工智能": ["AI 前沿", "AI 技术", "技术开发", "技术热点", "开发工具", "效率工具", "新产品"],
  "具身智能": ["具身智能", "机器人", "自动驾驶", "智能硬件"],
  "财经": ["财经科技", "金融科技", "财经新闻", "投资分析"],
  "天津": ["天津", "天津新闻", "滨海新区", "天开园", "政情"],
  "创投": ["创投科技", "创业投资"],
};
---

<nav class="category-nav">
  <div class="nav-container">
    {categories.map(cat => (
      <button class="category-link" data-category={cat.id}>
        {cat.name}
      </button>
    ))}
  </div>
</nav>

<script>
  const categoryMapping: Record<string, string[]> = {
    "人工智能": ["AI 前沿", "AI 技术", "技术开发", "技术热点", "开发工具", "效率工具", "新产品"],
    "具身智能": ["具身智能", "机器人", "自动驾驶", "智能硬件"],
    "财经": ["财经科技", "金融科技", "财经新闻", "投资分析"],
    "天津": ["天津", "天津新闻", "滨海新区", "天开园", "政情"],
    "创投": ["创投科技", "创业投资"],
  };
  
  function initCategoryNav() {
    const buttons = document.querySelectorAll('.category-link');
    const articles = document.querySelectorAll('.article-card, .carousel-slide');
    
    if (buttons.length === 0) return;
    
    // 默认选中"全部"
    const allBtn = document.querySelector('.category-link[data-category="all"]');
    if (allBtn) allBtn.classList.add('active');
    
    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        // 更新按钮状态
        buttons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        
        const category = btn.getAttribute('data-category');
        if (!category) return;
        
        // 过滤文章
        articles.forEach(article => {
          const articleCategory = article.getAttribute('data-category') || '';
          
          let visible = category === 'all';
          
          if (!visible && categoryMapping[category]) {
            visible = categoryMapping[category].some(cat => 
              articleCategory.includes(cat)
            );
          }
          
          if (visible) {
            (article as HTMLElement).style.display = '';
          } else {
            (article as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  }
  
  // 页面加载完成后初始化
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCategoryNav);
  } else {
    initCategoryNav();
  }
</script>

<style>
  .category-nav {
    background: rgba(255, 255, 255, 0.6);
    border-bottom: 1px solid rgba(0, 119, 182, 0.08);
    padding: 0;
  }
  .nav-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    gap: 0;
  }
  .category-link {
    position: relative;
    padding: 16px 24px;
    background: transparent;
    border: none;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: #64748b;
    transition: all 0.25s ease;
    letter-spacing: 0.3px;
  }
  .category-link:hover {
    color: #0077b6;
    background: rgba(0, 119, 182, 0.04);
  }
  .category-link.active {
    color: #0077b6;
    font-weight: 600;
  }
  .category-link.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 16px;
    right: 16px;
    height: 2px;
    background: linear-gradient(90deg, #0077b6, #00b4d8);
    border-radius: 1px;
  }
  @media (max-width: 768px) {
    .nav-container {
      padding: 0 16px;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .nav-container::-webkit-scrollbar {
      display: none;
    }
    .category-link {
      padding: 14px 16px;
      font-size: 13px;
      white-space: nowrap;
    }
    .category-link.active::after {
      left: 12px;
      right: 12px;
    }
  }
</style>
