---
// 核心分类导航 - 英文版纯文字分栏设计
const categories = [
  { id: "all", name: "All" },
  { id: "人工智能", name: "AI" },
  { id: "具身智能", name: "Embodied AI" },
  { id: "财经", name: "Finance" },
  { id: "天津", name: "Tianjin" },
  { id: "创投", name: "Venture" },
];

// 分类映射：核心分类 → RSS 原始分类
const categoryMapping: Record<string, string[]> = {
  "人工智能": ["AI 前沿", "AI 技术", "大模型", "ChatGPT", "AGI", "AI 应用", "AI 创业"],
  "具身智能": ["具身智能", "机器人", "自动驾驶", "智能硬件"],
  "财经": ["财经科技", "金融科技", "财经新闻", "股市", "投资"],
  "天津": ["天津", "天津新闻", "滨海新区", "天开园"],
  "创投": ["创投科技", "创业投资", "融资", "IPO", "独角兽"],
};
---

<nav class="category-nav">
  <div class="nav-container">
    {categories.map(cat => (
      <button class="category-link" data-category={cat.id}>
        {cat.name}
      </button>
    ))}
  </div>
</nav>

<script>
  const categoryMapping = {
    "人工智能": ["AI 前沿", "AI 技术", "大模型", "ChatGPT", "AGI", "AI 应用", "AI 创业"],
    "具身智能": ["具身智能", "机器人", "自动驾驶", "智能硬件"],
    "财经": ["财经科技", "金融科技", "财经新闻", "股市", "投资"],
    "天津": ["天津", "天津新闻", "滨海新区", "天开园"],
    "创投": ["创投科技", "创业投资", "融资", "IPO", "独角兽"],
  };
  
  const buttons = document.querySelectorAll('.category-link');
  const articles = document.querySelectorAll('.article-card, .carousel-slide');
  
  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      buttons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      
      const category = btn.getAttribute('data-category');
      
      articles.forEach(article => {
        const articleCategory = article.getAttribute('data-category') || '';
        
        let visible = category === 'all';
        
        if (!visible && category && categoryMapping[category]) {
          visible = categoryMapping[category].some(cat => 
            articleCategory.includes(cat)
          );
        }
        
        if (visible) {
          article.style.display = 'block';
        } else {
          article.style.display = 'none';
        }
      });
    });
  });
</script>

<style>
  .category-nav {
    background: rgba(255, 255, 255, 0.6);
    border-bottom: 1px solid rgba(0, 119, 182, 0.08);
    padding: 0;
  }
  .nav-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    gap: 0;
  }
  .category-link {
    position: relative;
    padding: 16px 24px;
    background: transparent;
    border: none;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: #64748b;
    transition: all 0.25s ease;
    letter-spacing: 0.3px;
  }
  .category-link:hover {
    color: #0077b6;
    background: rgba(0, 119, 182, 0.04);
  }
  .category-link.active {
    color: #0077b6;
    font-weight: 600;
  }
  .category-link.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 16px;
    right: 16px;
    height: 2px;
    background: linear-gradient(90deg, #0077b6, #00b4d8);
    border-radius: 1px;
  }
  @media (max-width: 768px) {
    .nav-container {
      padding: 0 16px;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .nav-container::-webkit-scrollbar {
      display: none;
    }
    .category-link {
      padding: 14px 16px;
      font-size: 13px;
      white-space: nowrap;
    }
    .category-link.active::after {
      left: 12px;
      right: 12px;
    }
  }
</style>
