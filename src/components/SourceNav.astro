---
// 信息源导航 - 纯文字分栏设计
const sources = [
  { id: "all", name: "全部" },
  // 中文 AI/科技
  { id: "机器之心", name: "机器之心" },
  { id: "量子位", name: "量子位" },
  { id: "虎嗅", name: "虎嗅" },
  { id: "36 氪", name: "36 氪" },
  { id: "爱范儿", name: "爱范儿" },
  { id: "少数派", name: "少数派" },
  // 金融财经
  { id: "华尔街见闻", name: "华尔街见闻" },
  { id: "财联社", name: "财联社" },
  { id: "东方财富", name: "东方财富" },
  // 开发者/技术
  { id: "掘金", name: "掘金" },
  { id: "开源中国", name: "开源中国" },
  // 国际
  { id: "TechCrunch", name: "TechCrunch" },
  { id: "Ars Technica", name: "Ars Technica" },
  { id: "MIT", name: "MIT" },
];
---

<nav class="source-nav">
  <div class="nav-container">
    {sources.map(source => (
      <button class="source-link" data-source={source.id}>
        {source.name}
      </button>
    ))}
  </div>
</nav>

<script>
  function initSourceNav() {
    const buttons = document.querySelectorAll('.source-link');
    const articles = document.querySelectorAll('.article-card');
    
    if (buttons.length === 0) return;
    
    // 默认选中"全部"
    const allBtn = document.querySelector('.source-link[data-source="all"]');
    if (allBtn) allBtn.classList.add('active');
    
    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        // 更新按钮状态
        buttons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        
        const source = btn.getAttribute('data-source');
        if (!source) return;
        
        // 过滤文章
        articles.forEach(article => {
          const articleSource = article.getAttribute('data-source') || '';
          
          const visible = source === 'all' || 
                         articleSource === source || 
                         articleSource.includes(source);
          
          if (visible) {
            article.style.display = '';
          } else {
            article.style.display = 'none';
          }
        });
      });
    });
  }
  
  // 页面加载完成后初始化
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSourceNav);
  } else {
    initSourceNav();
  }
</script>

<style>
  .source-nav {
    background: rgba(255, 255, 255, 0.4);
    border-bottom: 1px solid rgba(0, 119, 182, 0.06);
    padding: 0;
  }
  .nav-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    gap: 0;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .nav-container::-webkit-scrollbar {
    display: none;
  }
  .source-link {
    position: relative;
    padding: 12px 18px;
    background: transparent;
    border: none;
    cursor: pointer;
    font-size: 13px;
    font-weight: 400;
    color: #94a3b8;
    transition: all 0.25s ease;
    letter-spacing: 0.2px;
    white-space: nowrap;
  }
  .source-link:hover {
    color: #64748b;
    background: rgba(0, 119, 182, 0.03);
  }
  .source-link.active {
    color: #0077b6;
    font-weight: 500;
  }
  .source-link.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 12px;
    right: 12px;
    height: 2px;
    background: #0077b6;
    border-radius: 1px;
  }
  @media (max-width: 768px) {
    .nav-container {
      padding: 0 16px;
    }
    .source-link {
      padding: 10px 14px;
      font-size: 12px;
    }
    .source-link.active::after {
      left: 10px;
      right: 10px;
    }
  }
</style>
