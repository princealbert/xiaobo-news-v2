---
// 信息源导航 - 英文版纯文字分栏设计
const sources = [
  { id: "all", name: "All" },
  // 中文 AI/科技
  { id: "机器之心", name: "Synced" },
  { id: "量子位", name: "QbitAI" },
  { id: "虎嗅", name: "Huxiu" },
  { id: "36 氪", name: "36Kr" },
  { id: "爱范儿", name: "ifanr" },
  { id: "少数派", name: "sspai" },
  // 金融财经
  { id: "华尔街见闻", name: "WSJ" },
  { id: "财联社", name: "CLS" },
  { id: "东方财富", name: "Eastmoney" },
  // 开发者/技术
  { id: "掘金", name: "Juejin" },
  { id: "开源中国", name: "OSChina" },
  // 国际
  { id: "TechCrunch", name: "TechCrunch" },
  { id: "Ars Technica", name: "Ars" },
  { id: "MIT", name: "MIT" },
];
---

<nav class="source-nav">
  <div class="nav-container">
    {sources.map(source => (
      <button class="source-link" data-source={source.id}>
        {source.name}
      </button>
    ))}
  </div>
</nav>

<script>
  const buttons = document.querySelectorAll('.source-link');
  const articles = document.querySelectorAll('.article-card');
  
  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      buttons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      
      const source = btn.getAttribute('data-source');
      
      articles.forEach(article => {
        const articleSource = article.getAttribute('data-source') || '';
        if (source === 'all' || articleSource === source || articleSource.includes(source)) {
          article.style.display = 'block';
        } else {
          article.style.display = 'none';
        }
      });
    });
  });
</script>

<style>
  .source-nav {
    background: rgba(255, 255, 255, 0.4);
    border-bottom: 1px solid rgba(0, 119, 182, 0.06);
    padding: 0;
  }
  .nav-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    gap: 0;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .nav-container::-webkit-scrollbar {
    display: none;
  }
  .source-link {
    position: relative;
    padding: 12px 18px;
    background: transparent;
    border: none;
    cursor: pointer;
    font-size: 13px;
    font-weight: 400;
    color: #94a3b8;
    transition: all 0.25s ease;
    letter-spacing: 0.2px;
    white-space: nowrap;
  }
  .source-link:hover {
    color: #64748b;
    background: rgba(0, 119, 182, 0.03);
  }
  .source-link.active {
    color: #0077b6;
    font-weight: 500;
  }
  .source-link.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 12px;
    right: 12px;
    height: 2px;
    background: #0077b6;
    border-radius: 1px;
  }
  @media (max-width: 768px) {
    .nav-container {
      padding: 0 16px;
    }
    .source-link {
      padding: 10px 14px;
      font-size: 12px;
    }
    .source-link.active::after {
      left: 10px;
      right: 10px;
    }
  }
</style>
